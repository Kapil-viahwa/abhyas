# Copy to .env for local runs and docker compose. Never commit real values.

# Runtime
NODE_ENV=development
PORT=3001

# Data stores.
# The API connects as the non-superuser application role (abhyas_app).
DATABASE_URL=postgresql://abhyas_app:abhyas_app@localhost:5432/abhyas
# Migrations run as the separate owner role.
MIGRATION_DATABASE_URL=postgresql://abhyas:abhyas@localhost:5432/abhyas
# Tests only: the application-role connection used to prove its privileges.
APP_DATABASE_URL=postgresql://abhyas_app:abhyas_app@localhost:5432/abhyas
REDIS_URL=redis://localhost:6379

# Web -> API (server side only; never exposed to the browser)
API_INTERNAL_URL=http://localhost:3001

# Public base URL of the web app, used for links the API puts in email.
# Production requires it, and requires https.
WEB_URL=http://localhost:3000

# Secrets. Development values only; production refuses well-known defaults.
AUTH_SECRET=dev-only-insecure-secret-please-change-32chars

# Bot protection (Cloudflare Turnstile).
# Development may use a Turnstile test key. Production refuses test keys.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Site key rendered into the widget. Development may use the always-pass test key;
# production requires a real one (apps/web/src/lib/config.ts refuses a test key).
TURNSTILE_SITE_KEY=1x0000000000000000000000000000000AA

# SMS: fake | console | msg91 | twilio | ses
# Production refuses fake and console.
SMS_PROVIDER=fake

# Email: console (logs an outbox entry) | smtp
# Production refuses console.
EMAIL_PROVIDER=console

# Development-only convenience login. Production refuses this flag.
ALLOW_DEV_LOGIN=true

# First administrator seed (pnpm db:seed:admin).
# There is no default password: both variables must be set explicitly.
# Production additionally requires SEED_ADMIN_CONFIRM=create-first-admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Abhyas Administrator
SEED_ADMIN_CONFIRM=

# Production compose (docker-compose.prod.yml) requires all of these explicitly.
POSTGRES_USER=abhyas
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=abhyas
WEB_PORT=3000
