{
  "name": "@abhyas/api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "pnpm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "pnpm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run prisma:generate && vitest run src",
    "test:db": "pnpm run prisma:generate && vitest run test/migrations.test.ts",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@abhyas/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.22.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0"
  }
}
