{
  "name": "@abhyas/api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "pnpm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "pnpm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run prisma:generate && vitest run src",
    "test:db": "pnpm run prisma:generate && vitest run test --no-file-parallelism",
    "db:migrate": "prisma migrate deploy",
    "seed:admin": "node dist/seed/cli.js",
    "seed:catalog": "node dist/seed/cli-catalog.js"
  },
  "dependencies": {
    "@abhyas/shared": "workspace:*",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-fastify": "^11.1.18",
    "@nestjs/swagger": "^11.0.0",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/client": "^5.22.0",
    "fastify": "^5.12.5",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0"
  }
}
