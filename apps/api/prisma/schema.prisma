generator client {
  provider      = "prisma-client-js"
  // The images are node:22-bookworm-slim (Debian 12, OpenSSL 3). Declaring the
  // target stops the CLI from guessing openssl-1.1.x, whose engine cannot load.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Phase 0 only: a trivial table so the migration pipeline has something real to apply.
model AppMetadata {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_metadata")
}

/// Phase 1 identity foundation. Constraints, normalising triggers and append-only
/// rules live in hand-written SQL; this model is the typed access layer only.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique(map: "users_email_key")
  mobile           String?   @unique(map: "users_mobile_key")
  passwordHash     String    @map("password_hash")
  fullName         String    @map("full_name")
  roleId           String    @map("role_id") @db.Uuid
  status           String    @default("ACTIVE")
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(6)
  mobileVerifiedAt DateTime? @map("mobile_verified_at") @db.Timestamptz(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  role               Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permissions        UserPermission[] @relation("UserPermissions")
  grantedPermissions UserPermission[] @relation("GrantedPermissions")
  updatedSettings    Setting[]        @relation("SettingUpdates")
  auditEntries       AuditLog[]       @relation("AuditActor")
  sessions           Session[]
  emailTokens        EmailToken[]

  @@map("users")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  userPermissions UserPermission[]
  rolePermissions RolePermission[]

  @@map("permissions")
}

/// The role x permission matrix, seeded by migration from docs/permissions.md.
model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
}

model UserPermission {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedBy    String?  @map("granted_by") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  user          User       @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  grantedByUser User?      @relation("GrantedPermissions", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId], map: "user_permissions_user_permission_key")
  @@map("user_permissions")
}

model Setting {
  key         String   @id
  valueType   String   @map("value_type")
  valueText   String?  @map("value_text")
  valueInt    Int?     @map("value_int")
  valueBool   Boolean? @map("value_bool")
  minInt      Int?     @map("min_int")
  maxInt      Int?     @map("max_int")
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  updatedByUser User? @relation("SettingUpdates", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("settings")
}

/// Append-only: the database rejects UPDATE, DELETE and TRUNCATE, and the
/// application role has those privileges revoked.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   String?  @map("actor_role")
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json     @default("{}")
  ip          String?

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt], map: "audit_logs_occurred_at_idx")
  @@index([entityType, entityId], map: "audit_logs_entity_idx")
  @@map("audit_logs")
}

/// Phase 2a: one row per refresh token. Rotation keeps the family id, so replaying an
/// old token revokes every descendant in a single statement.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique(map: "sessions_refresh_token_hash_key") @map("refresh_token_hash")
  accessTokenHash  String?   @unique(map: "sessions_access_token_hash_key") @map("access_token_hash")
  accessExpiresAt  DateTime? @map("access_expires_at") @db.Timestamptz(6)
  issuedAt         DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?   @map("revoke_reason")
  ip               String?
  userAgent        String?   @map("user_agent")
  deviceLabel      String?   @map("device_label")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_id_idx")
  @@index([familyId], map: "sessions_family_id_idx")
  @@map("sessions")
}

/// Single-use verification and password-reset tokens, stored hashed.
model EmailToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  purpose   String
  tokenHash String    @unique(map: "email_tokens_token_hash_key") @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  requestIp String?   @map("request_ip")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose], map: "email_tokens_user_purpose_idx")
  @@map("email_tokens")
}

/// Transactional outbox. Registration publishes user.registered in the same
/// transaction that creates the user, so a later wallet consumer cannot miss it.
model DomainEvent {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  payload     Json      @default("{}")
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  attempts    Int       @default(0)

  @@index([occurredAt], map: "domain_events_occurred_at_idx")
  @@map("domain_events")
}
