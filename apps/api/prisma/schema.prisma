generator client {
  provider      = "prisma-client-js"
  // The images are node:22-bookworm-slim (Debian 12, OpenSSL 3). Declaring the
  // target stops the CLI from guessing openssl-1.1.x, whose engine cannot load.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Phase 0 only: a trivial table so the migration pipeline has something real to apply.
model AppMetadata {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_metadata")
}

/// Phase 1 identity foundation. Constraints, normalising triggers and append-only
/// rules live in hand-written SQL; this model is the typed access layer only.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  // Nullable since phase 2c: an account may be identified by a verified mobile only.
  email            String?   @unique(map: "users_email_key")
  mobile           String?   @unique(map: "users_mobile_key")
  // E.164, written once a number has been verified; unique across the platform.
  firstVerifiedMobile String? @map("first_verified_mobile")
  passwordHash     String    @map("password_hash")
  fullName         String    @map("full_name")
  roleId           String    @map("role_id") @db.Uuid
  status           String    @default("ACTIVE")
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(6)
  mobileVerifiedAt DateTime? @map("mobile_verified_at") @db.Timestamptz(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  role               Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permissions        UserPermission[] @relation("UserPermissions")
  grantedPermissions UserPermission[] @relation("GrantedPermissions")
  updatedSettings    Setting[]        @relation("SettingUpdates")
  auditEntries       AuditLog[]       @relation("AuditActor")
  sessions           Session[]
  emailTokens        EmailToken[]
  examCategories     ExamCategory[] @relation("ExamCategoryCreator")
  exams              Exam[]        @relation("ExamCreator")
  subjects           Subject[]     @relation("SubjectCreator")
  topics             Topic[]       @relation("TopicCreator")
  mediaAssets        MediaAsset[]   @relation("MediaUploader")
  questions          Question[]     @relation("QuestionCreator")
  questionVersions   QuestionVersion[] @relation("QuestionVersionAuthor")
  importJobs         ImportJob[]    @relation("ImportJobCreator")
  coinWallet         CoinWallet?    @relation("CoinWalletOwner")
  coinTransactions   CoinTransaction[] @relation("CoinLedgerOwner")
  coinEntriesCreated CoinTransaction[] @relation("CoinLedgerCreator")
  coinRewards        CoinDailyReward[] @relation("CoinRewardOwner")
  coinBulkJobs       CoinBulkJob[]    @relation("CoinBulkJobCreator")
  coinBulkRows       CoinBulkJobRow[] @relation("CoinBulkRowUser")

  @@map("users")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  userPermissions UserPermission[]
  rolePermissions RolePermission[]

  @@map("permissions")
}

/// The role x permission matrix, seeded by migration from docs/permissions.md.
model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
}

model UserPermission {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedBy    String?  @map("granted_by") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  user          User       @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  grantedByUser User?      @relation("GrantedPermissions", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId], map: "user_permissions_user_permission_key")
  @@map("user_permissions")
}

model Setting {
  key         String   @id
  valueType   String   @map("value_type")
  valueText   String?  @map("value_text")
  valueInt    Int?     @map("value_int")
  valueBool   Boolean? @map("value_bool")
  minInt      Int?     @map("min_int")
  maxInt      Int?     @map("max_int")
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  updatedByUser User? @relation("SettingUpdates", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("settings")
}

/// Append-only: the database rejects UPDATE, DELETE and TRUNCATE, and the
/// application role has those privileges revoked.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   String?  @map("actor_role")
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json     @default("{}")
  ip          String?

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt], map: "audit_logs_occurred_at_idx")
  @@index([entityType, entityId], map: "audit_logs_entity_idx")
  @@map("audit_logs")
}

/// Phase 2a: one row per refresh token. Rotation keeps the family id, so replaying an
/// old token revokes every descendant in a single statement.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique(map: "sessions_refresh_token_hash_key") @map("refresh_token_hash")
  accessTokenHash  String?   @unique(map: "sessions_access_token_hash_key") @map("access_token_hash")
  accessExpiresAt  DateTime? @map("access_expires_at") @db.Timestamptz(6)
  issuedAt         DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  /// Stamped on every authenticated request, so the account page can show activity.
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?   @map("revoke_reason")
  ip               String?
  userAgent        String?   @map("user_agent")
  deviceLabel      String?   @map("device_label")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_id_idx")
  @@index([familyId], map: "sessions_family_id_idx")
  @@map("sessions")
}

/// Single-use verification and password-reset tokens, stored hashed.
model EmailToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  purpose   String
  tokenHash String    @unique(map: "email_tokens_token_hash_key") @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  requestIp String?   @map("request_ip")
  // The address a LINK_EMAIL token will confirm; null for verification and reset tokens.
  destination String? @map("destination")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose], map: "email_tokens_user_purpose_idx")
  @@map("email_tokens")
}

/// Transactional outbox. Registration publishes user.registered in the same
/// transaction that creates the user, so a later wallet consumer cannot miss it.
model DomainEvent {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  payload     Json      @default("{}")
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  attempts    Int       @default(0)

  @@index([occurredAt], map: "domain_events_occurred_at_idx")
  @@map("domain_events")
}

/// Phase 3: the catalog. Two levels of category, then exams, subjects and topics.
/// Ownership is recorded here and enforced by the catalog service.
model ExamCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique(map: "exam_categories_slug_key")
  description String?
  parentId    String?  @map("parent_id") @db.Uuid
  logoKey     String?  @map("logo_key")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   ExamCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ExamCategory[] @relation("CategoryTree")
  creator  User           @relation("ExamCategoryCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  exams    Exam[]

  @@index([parentId], map: "exam_categories_parent_id_idx")
  @@map("exam_categories")
}

model Exam {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String
  slug        String   @unique(map: "exams_slug_key")
  description String?
  logoKey     String?  @map("logo_key")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category ExamCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator  User         @relation("ExamCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  subjects Subject[]
  questions Question[]  @relation("QuestionExam")

  @@index([categoryId], map: "exams_category_id_idx")
  @@index([createdBy], map: "exams_created_by_idx")
  @@map("exams")
}

model Subject {
  id          String   @id @default(uuid()) @db.Uuid
  examId      String   @map("exam_id") @db.Uuid
  name        String
  slug        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Restrict)
  creator User    @relation("SubjectCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  topics  Topic[]
  questions Question[] @relation("QuestionSubject")

  @@unique([examId, slug], map: "subjects_exam_slug_key")
  @@index([examId], map: "subjects_exam_id_idx")
  @@map("subjects")
}

model Topic {
  id          String   @id @default(uuid()) @db.Uuid
  subjectId   String   @map("subject_id") @db.Uuid
  name        String
  slug        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  creator User    @relation("TopicCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  questions Question[] @relation("QuestionTopic")

  @@unique([subjectId, slug], map: "topics_subject_slug_key")
  @@index([subjectId], map: "topics_subject_id_idx")
  @@map("topics")
}

/// Phase 4: one question in the authoring record. The catalog row it belongs to is
/// where ownership starts; versions hold the text, so publishing one is immutable.
model Question {
  id             String   @id @default(uuid()) @db.Uuid
  examId         String   @map("exam_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  topicId        String?  @map("topic_id") @db.Uuid
  createdBy      String   @map("created_by") @db.Uuid
  status         String   @default("DRAFT")
  currentVersion Int      @default(1) @map("current_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam      Exam            @relation("QuestionExam", fields: [examId], references: [id], onDelete: Restrict)
  subject   Subject         @relation("QuestionSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  topic     Topic?          @relation("QuestionTopic", fields: [topicId], references: [id], onDelete: Restrict)
  creator   User            @relation("QuestionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  versions  QuestionVersion[]
  importRows ImportRow[]

  @@index([examId], map: "questions_exam_id_idx")
  @@index([subjectId], map: "questions_subject_id_idx")
  @@index([topicId], map: "questions_topic_id_idx")
  @@index([createdBy], map: "questions_created_by_idx")
  @@index([status], map: "questions_status_idx")
  @@map("questions")
}

model QuestionVersion {
  id              String   @id @default(uuid()) @db.Uuid
  questionId      String   @map("question_id") @db.Uuid
  version         Int
  questionType    String   @map("question_type")
  language        String
  difficulty      String
  contentHtml     String   @map("content_html")
  explanationHtml String?  @map("explanation_html")
  latex           String?
  numericalAnswer String?  @map("numerical_answer")
  marks           Decimal  @db.Decimal(6, 2)
  negativeMarks   Decimal  @default(0) @map("negative_marks") @db.Decimal(6, 2)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  question Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User             @relation("QuestionVersionAuthor", fields: [createdBy], references: [id], onDelete: Restrict)
  options  QuestionOption[]

  @@unique([questionId, version], map: "question_versions_question_version_key")
  @@map("question_versions")
}

model QuestionOption {
  id         String  @id @default(uuid()) @db.Uuid
  versionId  String  @map("question_version_id") @db.Uuid
  position   Int
  optionHtml String  @map("option_html")
  latex      String?
  isCorrect  Boolean @default(false) @map("is_correct")
  imageId    String? @map("image_id") @db.Uuid

  version QuestionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  image   MediaAsset?     @relation("OptionImage", fields: [imageId], references: [id], onDelete: SetNull)

  @@unique([versionId, position], map: "question_options_version_position_key")
  @@map("question_options")
}

/// Phase 4: a bulk import. The file lands in object storage, the worker validates every
/// row into the staging table, and the commit is all or nothing.
model ImportJob {
  id                String    @id @default(uuid()) @db.Uuid
  createdBy         String    @map("created_by") @db.Uuid
  status            String    @default("QUEUED")
  sourceKey         String    @map("source_key")
  sourceName        String    @map("source_name")
  imageKey          String?   @map("image_key")
  totalRows         Int       @default(0) @map("total_rows")
  validRows         Int       @default(0) @map("valid_rows")
  invalidRows       Int       @default(0) @map("invalid_rows")
  committedQuestions Int      @default(0) @map("committed_questions")
  errorMessage      String?   @map("error_message")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt         DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz(6)

  creator User        @relation("ImportJobCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  rows    ImportRow[]
  commit  ImportCommit?

  @@index([createdBy], map: "import_jobs_created_by_idx")
  @@map("import_jobs")
}

model ImportRow {
  id              String   @id @default(uuid()) @db.Uuid
  jobId           String   @map("job_id") @db.Uuid
  rowNumber       Int      @map("row_number")
  externalId      String?  @map("external_id")
  status          String   @default("PENDING")
  errors          Json     @default("[]")
  payload         Json     @default("{}")
  questionId      String?  @map("question_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  job      ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@unique([jobId, rowNumber], map: "import_rows_job_row_key")
  @@map("import_rows")
}

/// One row per committed job: the idempotency key that makes a worker restart harmless.
model ImportCommit {
  jobId     String   @id @map("job_id") @db.Uuid
  committedAt DateTime @default(now()) @map("committed_at") @db.Timestamptz(6)
  questions Int

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("import_commits")
}

/// Phase 4: an image the API re-encoded and stored. The bucket is private, so the row
/// records storage facts only; every read is a presigned URL with a short life.
model MediaAsset {
  id             String   @id @default(uuid()) @db.Uuid
  bucket         String
  objectKey      String   @unique(map: "media_assets_object_key_key") @map("object_key")
  mimeType       String   @map("mime_type")
  byteSize       Int      @map("byte_size")
  width          Int
  height         Int
  checksumSha256 String   @map("checksum_sha256")
  uploadedBy     String   @map("uploaded_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  uploader       User             @relation("MediaUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  optionImages   QuestionOption[] @relation("OptionImage")

  @@index([uploadedBy], map: "media_assets_uploaded_by_idx")
  @@map("media_assets")
}



/// Phase 2c: one code sent to one number. The code itself is never stored — `codeHmac` is
/// an HMAC with a server secret, so a database read cannot recover a live code.
model OtpRequest {
  id              String    @id @default(uuid()) @db.Uuid
  destination     String
  destinationHash String    @map("destination_hash")
  purpose         String
  codeHmac        String    @map("code_hmac")
  attempts        Int       @default(0)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(6)
  ipHash          String?   @map("ip_hash")
  deviceHash      String?   @map("device_hash")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([destinationHash], map: "otp_requests_destination_hash_idx")
  @@index([createdAt], map: "otp_requests_created_at_idx")
  @@map("otp_requests")
}

/// Phase 2c: one row per message handed to a provider, so the daily budget and the invoice
/// can be reconciled against something the platform wrote down itself.
model SmsCostLedger {
  id                String   @id @default(uuid()) @db.Uuid
  provider          String
  destinationHash   String   @map("destination_hash")
  cost              Decimal  @default(0) @db.Decimal(10, 4)
  providerMessageId String?  @map("provider_message_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "sms_cost_ledger_created_at_idx")
  @@map("sms_cost_ledger")
}


/// Phase 5: one wallet per person. The balance is a cache of the ledger — the ledger's
/// trigger moves it, and a second trigger refuses any other writer.
model CoinWallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique(map: "coin_wallets_user_id_key") @map("user_id") @db.Uuid
  balance   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User @relation("CoinWalletOwner", fields: [userId], references: [id], onDelete: Restrict)

  @@map("coin_wallets")
}

/// Phase 5: the append-only record of what moved and why. One row per intent, keyed by an
/// idempotency key, so replaying a request returns the row instead of writing a second one.
model CoinTransaction {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  type               String
  /// Signed: negative for a charge, positive for a grant or an admin credit.
  amount             Int
  previousBalance    Int      @map("previous_balance")
  newBalance         Int      @map("new_balance")
  referenceType      String?  @map("reference_type")
  referenceId        String?  @map("reference_id")
  description        String?
  createdBy          String?  @map("created_by") @db.Uuid
  idempotencyKey     String   @map("idempotency_key")
  requestFingerprint String   @map("request_fingerprint")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User  @relation("CoinLedgerOwner", fields: [userId], references: [id], onDelete: Restrict)
  creator User? @relation("CoinLedgerCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  dailyReward CoinDailyReward? @relation("CoinRewardEntry")
  bulkRow     CoinBulkJobRow?  @relation("CoinBulkRowEntry")

  @@unique([userId, idempotencyKey], map: "coin_transactions_user_idempotency_key")
  @@index([userId, createdAt], map: "coin_transactions_user_created_at_idx")
  @@index([type, createdAt], map: "coin_transactions_type_created_at_idx")
  @@map("coin_transactions")
}


/// Phase 5: the daily reward record, one row per person per Asia/Kolkata day. The ledger
/// row that pays it and this row are written in one transaction, so parallel sign-ins pay
/// once: `UNIQUE (user_id, reward_date)` is the decision, and the ledger row is the proof.
model CoinDailyReward {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  rewardDate        DateTime @map("reward_date") @db.Date
  amount            Int
  coinTransactionId String?  @unique(map: "daily_rewards_coin_transaction_id_key") @map("coin_transaction_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user            User             @relation("CoinRewardOwner", fields: [userId], references: [id], onDelete: Restrict)
  coinTransaction CoinTransaction? @relation("CoinRewardEntry", fields: [coinTransactionId], references: [id], onDelete: Restrict)

  @@unique([userId, rewardDate], map: "daily_rewards_user_date_key")
  @@map("daily_rewards")
}


/// Phase 5: one Administrator bulk coin assignment. The job row is the record; the worker
/// drains `QUEUED` jobs and writes one ledger row per person, keyed `<job_id>:<user_id>`, so
/// a job killed halfway and resumed credits everybody exactly once.
model CoinBulkJob {
  id            String    @id @default(uuid()) @db.Uuid
  createdBy     String    @map("created_by") @db.Uuid
  amount        Int
  remark        String
  status        String    @default("QUEUED")
  totalUsers    Int       @default(0) @map("total_users")
  creditedUsers Int       @default(0) @map("credited_users")
  failedUsers   Int       @default(0) @map("failed_users")
  errorMessage  String?   @map("error_message")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt     DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)

  creator User             @relation("CoinBulkJobCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  rows    CoinBulkJobRow[]

  @@index([status, createdAt], map: "coin_bulk_jobs_status_created_at_idx")
  @@map("coin_bulk_jobs")
}

/// Phase 5: one person in one bulk assignment, and what happened to them.
model CoinBulkJobRow {
  id                String   @id @default(uuid()) @db.Uuid
  jobId             String   @map("job_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  status            String   @default("PENDING")
  coinTransactionId String?  @unique(map: "coin_bulk_job_rows_coin_transaction_id_key") @map("coin_transaction_id") @db.Uuid
  errorMessage      String?  @map("error_message")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  job             CoinBulkJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user            User             @relation("CoinBulkRowUser", fields: [userId], references: [id], onDelete: Restrict)
  coinTransaction CoinTransaction? @relation("CoinBulkRowEntry", fields: [coinTransactionId], references: [id], onDelete: Restrict)

  @@unique([jobId, userId], map: "coin_bulk_job_rows_job_user_key")
  @@map("coin_bulk_job_rows")
}
