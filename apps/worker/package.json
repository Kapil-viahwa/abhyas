{
  "name": "@abhyas/worker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "prisma:generate": "prisma generate --schema ../api/prisma/schema.prisma",
    "build": "pnpm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "pnpm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@abhyas/shared": "workspace:*",
    "@aws-sdk/client-s3": "3.699.0",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.34.0",
    "exceljs": "4.4.0",
    "ioredis": "^5.4.2",
    "sharp": "0.35.5",
    "yauzl": "3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/yauzl": "2.10.3",
    "prisma": "^7.10.1"
  }
}
